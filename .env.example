# Copy to .env (git-ignored). NOTE: `langgraph dev` applies this file ON TOP of the shell environment, so anything set
# here beats `GANTRY_PROVIDER=openai make dev`. Leave GANTRY_PROVIDER unset (the default is offline) and choose it per run.
# --- models: offline (default: deterministic, free, no keys) | auto | anthropic | openai -------------------------------
# GANTRY_PROVIDER=offline
# ANTHROPIC_API_KEY=            # with GANTRY_PROVIDER=auto|anthropic Claude writes the polls and voices the producer
# ANTHROPIC_WORKSPACE_ID=       # only if your key is not scoped to a workspace (sent as `anthropic-workspace-id`)
# GANTRY_MODEL_SMART=claude-opus-5-5     # poll writing + the editor's re-rank (the model that makes judgement calls)
# GANTRY_MODEL_FAST=claude-haiku-5-5     # high-volume, latency-sensitive voice lines (notes, host messages, recaps)
# GANTRY_LLM_EFFORT=low                  # live TV is latency-bound; raise to medium/high if you slow the clock down
GANTRY_OFFLINE_TOKEN_DELAY_S=0.01
# --- OpenAI (opt-in) -----------------------------------------------------------------------------------------------------
# OPENAI_API_KEY=
# GANTRY_OPENAI_MODEL_SMART=gpt-5.4-mini
# GANTRY_OPENAI_MODEL_FAST=gpt-5.4-mini
# --- LangSmith tracing. Needed for Studio's Trace tab; also removes Studio's "LANGSMITH_API_KEY is missing" banner -------
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=gantry
# --- server ---------------------------------------------------------------------------------------------------------------
GANTRY_PUBLIC_BASE_URL=http://127.0.0.1:2030
RESUMABLE_STREAM_TTL_SECONDS=7200
